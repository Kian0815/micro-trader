APP_NAME=Micro Trader
APP_ENV=development
API_PORT_BIND=8000:8000
DB_PORT_BIND=127.0.0.1:5432:5432
PUBLIC_EQUITY_STATE_PATH=/app/state/plugins/oai-maintained-plugins/public-equity-investing/onboarding-state.json
DATABASE_URL=postgresql+psycopg://microtrader:microtrader@db:5432/microtrader
HOST_DATABASE_URL=postgresql+psycopg://microtrader:microtrader@localhost:5432/microtrader
ALPHAVANTAGE_API_KEY=
CRYPTO_DATA_PROVIDER=binance
ETF_DATA_PROVIDER=alpaca
ALPACA_QUOTE_CACHE_TTL_SECONDS=3600
FINIMPULSE_API_TOKEN=
TWELVEDATA_API_KEY=
BROKER_PROVIDER=none
BROKER_MODE=paper
BROKER_ENABLED=false
BROKER_EXECUTION_TARGET=internal
BROKER_LIVE_CONFIRMED=false
LIVE_EMERGENCY_STOP=true
LIVE_RUNBOOK_ACKNOWLEDGED=false
LIVE_ALERTS_CONFIGURED=false
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=
FX_RATE_PROVIDER=frankfurter
FX_QUOTE_TTL_SECONDS=1800
FX_USD_BUFFER_PCT=0.005
LOG_LEVEL=INFO
TRADING_ENABLED=true
SIMULATION_ENABLED=true
UNATTENDED_SETUP_STATUSES=approved
TRADEABLE_ASSET_KINDS=etf,stock,crypto
SIMULATION_ASSET_KINDS=etf,stock,crypto
STARTING_CAPITAL_EUR=1000
RESERVE_CASH_EUR=100
MAX_NOTIONAL_PER_TRADE_EUR=100
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_EUR=25
MIN_SIGNAL_SCORE_TO_BUY=0.62
MIN_SENTIMENT_SCORE_TO_BUY=0.12
MIN_MOMENTUM_SCORE_TO_BUY=0.03
MIN_NEWS_ITEMS_TO_BUY=1
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.03
TRAILING_STOP_PCT=0.008
MAX_TICK_AGE_SECONDS=900
MIN_MINUTES_BETWEEN_TRADES=30
WORKER_INTERVAL_SECONDS=300
WATCHLIST=BTC,ETH,SOL,LINK
ETF_WATCHLIST=SPY,QQQ,VTI
STOCK_WATCHLIST=AAPL,MSFT,NVDA
NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://news.google.com/rss/search?q=%22SPY%22%20OR%20%22S%26P%20500%22%20OR%20%22SPDR%20S%26P%20500%20ETF%22&hl=en-US&gl=US&ceid=US:en,https://news.google.com/rss/search?q=%22QQQ%22%20OR%20%22Nasdaq%20100%22%20OR%20%22Invesco%20QQQ%22&hl=en-US&gl=US&ceid=US:en,https://news.google.com/rss/search?q=%22VTI%22%20OR%20%22Total%20Stock%20Market%22%20OR%20%22Vanguard%20Total%20Stock%20Market%22&hl=en-US&gl=US&ceid=US:en
